{
  "name": "backend",
  "version": "1.0.50",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "generate": "bun drizzle-kit generate --config=./src/config/drizzle.config.ts",
    "migrate": "bun drizzle-kit migrate --config=./src/config/drizzle.config.ts",
    "better-auth:generate": "bunx --bun @better-auth/cli generate --output ./src/db/schema/auth.ts --config ./src/services/auth/providers/betterAuth.ts",
    "better-auth:migrate": "bunx --bun @better-auth/cli migrate --config ./src/services/auth/providers/betterAuth.ts",
    "test:setup": "NODE_ENV=test bun run scripts/test-setup.ts",
    "test:teardown": "NODE_ENV=test bun run scripts/test-teardown.ts",
    "test:integration": "NODE_ENV=test bun test tests/integration",
    "test:unit": "NODE_ENV=test bun test tests/unit",
    "test": "NODE_ENV=test bun run test:setup && bun run test:unit && bun run test:integration && bun run test:teardown"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/swagger": "^1.2.2",
    "@tqman/nice-logger": "^1.1.1",
    "better-auth": "^1.2.7",
    "drizzle-orm": "^0.42.0",
    "elysia": "^1.3.20",
    "kysely": "^0.28.1",
    "kysely-bun-worker": "^1.2.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.14.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.13",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.0"
  },
  "module": "src/index.js"
}
